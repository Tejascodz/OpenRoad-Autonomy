# ---------------------------------------------------------------------------
# OpenRoad-Autonomy configuration. Copy to `.env` (git-ignored) or, easier, run:
#     python scripts/setup_env.py
# NEVER commit a real .env. Only this template belongs in git.
# ---------------------------------------------------------------------------

# development | production | test
ENVIRONMENT=development
DEBUG=false

# REQUIRED in production: long random value. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# true = synthetic demo road grid, works with no internet (tests / demos)
OFFLINE_MAPS=false

# Sessions / cookies. COOKIE_SECURE must be true whenever you serve over HTTPS (always in production).
# For plain http://localhost development set it to false.
COOKIE_SECURE=false
ACCESS_TOKEN_TTL_MIN=30

# Network exposure. Keep 127.0.0.1 unless you run behind the nginx reverse proxy.
HOST=127.0.0.1
PORT=8000
# Comma-separated. Hostnames this server answers to (Host-header protection).
TRUSTED_HOSTS=localhost,127.0.0.1
# Comma-separated extra browser origins allowed to call the API (leave empty for same-origin only).
CORS_ORIGINS=

# One-time admin bootstrap (only used when the user table is empty). Prefer instead:
#   python -m app.cli create-user --username admin --role admin
# If you use it, delete the value after the first start.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Storage. Default: SQLite file at data/deliveries.db. docker-compose builds a Postgres URL
# from POSTGRES_* below; to use another Postgres server set:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
LOG_LEVEL=INFO

# Fleet / simulation (no physical robots: positions, speed and battery are simulated)
FLEET_SIZE=3
ROBOT_MAX_SPEED_KMH=25
SIM_TIME_SCALE=5

# Download the operating-area road map at startup (first route is then instant)
MAP_WARMUP=true
MAP_WARMUP_RADIUS_M=6000

# Road-map servers tried in order (comma-separated https URLs). Defaults include public mirrors.
# OVERPASS_URLS=https://overpass-api.de/api,https://overpass.kumi.systems/api

# Operating area (geofence)
GEOFENCE_CENTER_LAT=12.9716
GEOFENCE_CENTER_LON=77.5946
GEOFENCE_RADIUS_KM=25
MAX_TRIP_KM=15

# docker-compose only
POSTGRES_USER=robot
POSTGRES_DB=robotdb
POSTGRES_PASSWORD=
